# Desde Supabase → botón "Connect" → pestaña ORM → Prisma
# Ahí te da las dos variables ya armadas, solo hay que pegarlas.

# Pooled (transaction mode, puerto 6543) — la usa la app en cada query
DATABASE_URL="postgresql://postgres.xxxxx:[PASSWORD]@xxxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Directa (session mode, puerto 5432) — la usa Prisma solo para migraciones
DIRECT_URL="postgresql://postgres.xxxxx:[PASSWORD]@xxxxx.pooler.supabase.com:5432/postgres"

# Puerto del servidor local
PORT=4000

# Clave para firmar los JWT — generala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="reemplazar-con-una-clave-aleatoria-larga"
